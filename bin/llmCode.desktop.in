[Desktop Entry]
Version=1.0
Type=Application
Name=llmCode
GenericName=Local LLM Control Center & Coding Station
Comment=One-click launch for local llama.cpp server, OpenCode, Claude Code, and Codex CLI
Exec=@LLMCODE_DIR@/launch.sh
Icon=@LLMCODE_DIR@/bin/llmCode.svg
Terminal=false
Categories=Development;
Keywords=llm;llama;opencode;claude;codex;ai;code;
StartupNotify=true
StartupWMClass=llmCode
