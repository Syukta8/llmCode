# llmCode Environment Variables Reference
# Copy to .env or set in your environment if customization is needed.

# Host & Port Settings
# DEFAULT: 127.0.0.1 (localhost-only for security)
LLM_HOST=127.0.0.1
LLM_DASH_PORT=7860
LLM_ENGINE_PORT=8080

# Optional Hugging Face Hub Token for private or gated models
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# Optional OpenAI-compatible client overrides
# OPENAI_API_BASE=http://127.0.0.1:8080/v1
# OPENAI_API_KEY=
